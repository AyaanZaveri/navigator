# Google Generative AI API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
# Alternative link: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Optional: movie/TV cast headshots and character names (server-side only)
# Get an API Read Access Token from https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=

# Optional: evidence-backed web search for Ask Navigator (can also be set per device in Settings)
TINYFISH_API_KEY=

# Required for hosted production: set a private, stable 32-byte random key as 64 hex characters.
# Generate on the deployment machine: openssl rand -hex 32
# Local development and native desktop generate a persistent key outside the repository.
NAVIGATOR_SESSION_SECRET=
