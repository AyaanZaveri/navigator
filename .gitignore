# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-video
videos/*
!videos/*.json
!videos/*.js
!videos/*.ts
public/_next-video

/dist

# Native desktop outputs and downloaded libraries
/desktop/target/
/desktop/vendor/

.git.backup-*/

# Cloudflare generated output and local secrets
.open-next/
.wrangler/
.dev.vars*
cloudflare-env.d.ts

# Agent folders (including all files inside)
.agents/
.claude/
.codex/
.cursor/
.firecrawl/
.claw/
.github/instructions/
.github/agents/

# Standalone agent files outside those folders
AGENTS.md
CLAUDE.md
GEMINI.md
.cursorrules
skills-lock.json

# Keep shared editor defaults, not local tool connections
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
